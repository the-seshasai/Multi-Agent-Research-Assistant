# Copy this file to .env and fill in your own keys -- .env is gitignored.

# Gemini (LLM backing every agent). Get a free key from
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Tavily (web search used by the Researcher). Get a free key (1000
# searches/month) from https://app.tavily.com
TAVILY_API_KEY=

# Optional overrides -- see config.py / tools/search.py for defaults.
# RESEARCH_ASSISTANT_MODEL=gemini-2.0-flash
# RESEARCH_ASSISTANT_TEMPERATURE=0.2
# TAVILY_MAX_RESULTS=5
